# Service Configuration
NODE_ENV=development
PORT=3000
SERVICE_NAME=product-catalog-service
SERVICE_VERSION=1.0.0

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# DynamoDB Configuration
DYNAMODB_PRODUCTS_TABLE=products
DYNAMODB_ENDPOINT=http://localhost:8000

# AWS Secrets Manager
SECRETS_MANAGER_SECRET_NAME=shopcart/product-catalog/prod

# Logging
LOG_LEVEL=info

# API Configuration
API_VERSION=v1
API_BASE_PATH=/api/v1

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# CORS
CORS_ORIGIN=*

# AWS X-Ray
ENABLE_XRAY=true
